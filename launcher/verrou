# verrou : run a program under verrou.
#
#   verrou [OPTIONS] PROGRAM [ARGS...]
#
# Equivalent to "valgrind --tool=verrou [OPTIONS] PROGRAM [ARGS...]": OPTIONS
# are the verrou options and the valgrind core options. Using this command
# instead of valgrind keeps the scripts independent of the instrumentation
# engine.
#
# valgrind used: $VERROU_VALGRIND if set, otherwise the valgrind installed
# next to this command, otherwise the valgrind of the PATH.
# The process is replaced by valgrind (exec): exit code and signals are the
# ones of valgrind.

for arg in "$@"; do
    case "$arg" in
        --tool | --tool=*)
            echo "verrou: $arg is not accepted: the tool is verrou (use valgrind for another tool)" >&2
            exit 1
            ;;
        -*)
            ;;
        *)
            break # first word which is not an option: the program
            ;;
    esac
done

if [ -n "${VERROU_VALGRIND-}" ]; then
    vg=$VERROU_VALGRIND
else
    here=$(dirname "$(readlink -f "$0")")
    if [ -x "$here/valgrind" ]; then
        vg=$here/valgrind
    else
        vg=valgrind
    fi
fi

exec "$vg" --tool=verrou "$@"
