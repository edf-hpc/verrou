def mergeData(dataParsedTab, mergeBack=False):
    nbSeqRef=dataParsedTab[0]["cover"]["nbSeq"]
    nbCoverTabRef=dataParsedTab[0]["cover"]["nbCoverTab"]
    for dataParsed in dataParsedTab:
        nbSeq=dataParsed["cover"]["nbSeq"]
        nbCoverTab=dataParsed["cover"]["nbCoverTab"]
        if nbSeq!=nbSeqRef  or nbCoverTab!=nbCoverTabRef:
            print("incoherent data")
            sys.exit(42)
    mergedDataRes=[[None for cov in range(nbCoverTabRef[seq])] for seq in range(nbSeqRef) ]
    for seqIndex in range(nbSeqRef):
        for covIndex in range(nbCoverTabRef[seqIndex]):
            if mergeBack:
                mergedDataRes[seqIndex][covIndex]=mergeDataForOnePartialBack(dataParsedTab, seqIndex, covIndex)
            else:
                mergedDataRes[seqIndex][covIndex]=mergeDataForOnePartialCover(dataParsedTab, seqIndex, covIndex)
    return mergedDataRes


def computeBBEstimator( tabCount, tabStatus, refIndex, estimatorTab):
    countRef=tabCount[refIndex]
    statusRef=tabStatus[refIndex]
    assert(statusRef=="OK")

    equalOK, diffOK, equalKO, diffKO=(0,0,0,0)
    for index in range(len(tabCount)):
        isEqual= (tabCount[index]==countRef)
        isOK= (tabStatus[index]=="OK")

        if isEqual and isOK: equalOK+=1
        if isEqual and (not isOK): equalKO+=1
        if (not isEqual) and isOK: diffOK+=1
        if (not isEqual) and (not isOK): diffKO+=1

    #https://arxiv.org/pdf/1306.4546
    n11,n10,n01,n00  = diffKO,diffOK,equalKO,equalOK #notation for ochiai and tarantual

    res={}
    for estimatorStr in estimatorTab:
        estim=None
        if estimatorStr=="biased":
            estim= 0.5* (float(diffKO)/ float(diffKO+equalKO) + float(equalOK)/float(equalOK+diffOK))
        if estimatorStr=="standard":
            estim= float(diffKO + equalOK)/ float(equalOK + equalKO+ diffOK+diffKO)
        if estimatorStr=="ochiai":
            estim=n11 / math.sqrt( (n11+ n01) * (n11+ n10 ) )
        if estimatorStr=="tarantula":
            estim= (n11/ (n11+n01)) / ((n11 / (n11+n01)) + (n10 / (n10+n00)))
        res[estimatorStr]=estim

    return res


def updateEstimator(mergedData,dataParsedTab,estimatorTab=["standard","biased","ochiai", "tarantula"], backVersion=False):
    nbSeqRef=dataParsedTab[0]["cover"]["nbSeq"]
    nbCoverTabRef=dataParsedTab[0]["cover"]["nbCoverTab"]
    refIndex=getRefIndex(dataParsedTab)
    keyTab="covTab"
    if backVersion:
        keyTab="backTab"

    for seqIndex in range(nbSeqRef):
        for covIndex in range(nbCoverTabRef[seqIndex]):
            for indexBB in range(len(mergedData[seqIndex][covIndex])):
                bbDict=mergedData[seqIndex][covIndex][indexBB]

                bbDict["estimator"]=computeBBEstimator(bbDict[keyTab],
                                                       [x["return_value"] for x in dataParsedTab],
                                                       refIndex,
                                                       estimatorTab)


def dumpCSVdata( mergeData, dataParsedTab, estimatorTab, output=".", backVersion=False):
    nbSeqRef=dataParsedTab[0]["cover"]["nbSeq"]
    nbCoverTabRef=dataParsedTab[0]["cover"]["nbCoverTab"]

    for seqIndex in range(nbSeqRef):
        for covIndex in range(nbCoverTabRef[seqIndex]):
            name="coverage"
            if backVersion:
                name="backCover"
            outPutHandler=open(str(output)+ "/"+name+"Data_seq%i_cover%i.csv"%(seqIndex, covIndex),"w")
            #header
            levelPrefix=""
            if backVersion:
                levelPrefix="\t"

            outPutHandler.write(levelPrefix+"" +"\t" + "\t".join(estimatorTab)+"\n")
            outPutHandler.write(levelPrefix+"conf_name" +"\t" + "\t".join([""]*len(estimatorTab))+ "\t"+"\t".join([str(x["conf_name"]) for x in dataParsedTab]) +"\n" )
            outPutHandler.write(levelPrefix+"indexRun" +"\t" + "\t".join([""]*len(estimatorTab))+ "\t"+ "\t".join([str(x["runIndex"]) for x in dataParsedTab])  +"\n")
            outPutHandler.write(levelPrefix+"rounding" +"\t" + "\t".join([""]*len(estimatorTab))+ "\t"+"\t".join([str(x["rounding"]) for x in dataParsedTab])  +"\n")
            outPutHandler.write(levelPrefix+"return_value" +"\t" +"\t".join([""]*len(estimatorTab))+ "\t"+ "\t".join([str(x["return_value"]) for x in dataParsedTab])  +"\n")

            #data
            mergeDataSeqCov=mergeData[seqIndex][covIndex]
            if backVersion:
                print("mergeDataSeqCov",mergeDataSeqCov)
                for backLine in mergeDataSeqCov:
                    if backLine["tupleData"][0]=="BB":
                        level=backLine["tupleData"][1]
                        BBName=backLine["tupleData"][2]

                        outPutHandler.write(str(level)+"\t"+BBName +"\t"+ "\t".join([str(backLine["estimator"][key]) for key in estimatorTab])+"\t"  + "\t".join([str(x) for x in  backLine["backTab"]])+"\n")
                    if backLine["tupleData"][0]=="back":
                        level=backLine["tupleData"][1]
                        sym=backLine["tupleData"][2]
                        fileName=backLine["tupleData"][3]
                        lineNum=backLine["tupleData"][4]
                        name=sym+" "+fileName+":"+str(lineNum)

                        outPutHandler.write("|"+str(level)+"\t"+name +"\t"+ "\t".join(["" for key in estimatorTab])+"\t"  + "\t".join(["" for x in  backLine["backTab"]])+"\n")

            else:
                for bb in mergeDataSeqCov:
                    outPutHandler.write(bb["bbStr"] +"\t"+ "\t".join([str(bb["estimator"][key]) for key in estimatorTab])+"\t"  + "\t".join([str(x) for x in  bb["covTab"]])+"\n")
            outPutHandler.close()


