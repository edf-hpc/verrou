"""Convert the trace generated by verrou_dd_* --trace-file=FILE into a Paje trace (readable by ViTE)
or an OTF2 archive (readable by ViTE or Vampir) and print statistics about the parallel efficiency."""

import sys
import os
import json
import bisect
from pathlib import Path
import gen_config


def loadTrace(fileName):
    header=None
    events=[]
    with open(str(fileName)) as f:
        for lineNum,line in enumerate(f):
            line=line.strip()
            if line=="":
                continue
            try:
                data=json.loads(line)
            except json.JSONDecodeError:
                print("Warning: ignored line %i (interrupted trace ?)"%(lineNum+1), file=sys.stderr)
                continue
            if data["ev"]=="header":
                header=data
            else:
                events+=[data]
    if header==None:
        print("Error: no header in %s"%(fileName), file=sys.stderr)
        sys.exit(1)
    events.sort(key=lambda x: x["t"]) #stable : events written by several threads are not strictly ordered
    return header, events


def runtimeValue(section):
    """The runtime sections (testTab) are defined by the order of the sub-tasks and the earlyExit status"""
    info=section["info"]
    if not info.get("earlyExit", True):
        exitStatus="noEarlyExit"
    elif info.get("earlyConfExit","no")=="no":
        exitStatus="earlyExit"
    else:
        exitStatus=info["earlyConfExit"]
    return "%s_%s_%s"%(section["name"], info.get("sortOrder","?"), exitStatus)


class traceAnalysis:
    def __init__(self, header, events):
        self.header=header
        self.events=events
        self.nbSlot=max([header["nbProc"]]+[ev["slot"]+1 for ev in events if "slot" in ev])
        self.tEnd=max([0.]+[ev["t"] for ev in events])
        self.pairTasks()
        self.phases=self.pairSections("phase")
        self.runtimes=self.pairSections("runtime")
        self.computeBusy()
        self.pairOneMinimal()
        self.pairSameConfig()
        self.pairSplit()

    def pairTasks(self):
        """tasks : list of dict (kind, conf, sample, slot, begin, end, status, sampleStatus)"""
        self.tasks=[]
        current={}
        for ev in self.events:
            if ev["ev"]=="task_begin":
                task={key:ev[key] for key in ["kind","conf","sample","slot"]}
                task["begin"]=ev["t"]
                task["end"]=None
                task["status"]=None
                current[ev["slot"]]=task
                self.tasks+=[task]
            if ev["ev"]=="task_end":
                task=current.pop(ev["slot"], None)
                if task==None:
                    continue
                task["end"]=ev["t"]
                task["status"]=ev["status"]
        for task in current.values(): #interrupted tasks
            task["end"]=self.tEnd

        #the status of a sample is given by the cmp task
        cmpStatus={}
        for task in self.tasks:
            if task["kind"]=="cmp" and task["status"]!=None:
                cmpStatus[(task["conf"],task["sample"])]="PASS" if task["status"]==0 else "FAIL"
        for task in self.tasks:
            task["sampleStatus"]=cmpStatus.get((task["conf"],task["sample"]),"unknown")

    def pairOneMinimal(self):
        """oneMinimalLinks : list of (kind, failTask, subTask) from the failing cmp tasks of each ddmin
        configuration to the cmp tasks of the sub-configurations (one delta removed) which prove its 1-minimality"""
        cmpTasks={}
        for task in self.tasks:
            if task["kind"]=="cmp":
                cmpTasks.setdefault(task["conf"],[]).append(task)
        self.oneMinimalLinks=[]
        self.nbSubConfWithoutTask=0
        for ev in self.events:
            if ev["ev"]!="event" or ev["name"]!="oneMinimal":
                continue
            info=ev["info"]
            failTasks=[task for task in cmpTasks.get(info["conf"],[]) if task["status"] not in [0,None]]
            for subConf in info["subConfs"]:
                subTasks=cmpTasks.get(subConf,[])
                if len(subTasks)==0:
                    self.nbSubConfWithoutTask+=1 #cache from a previous execution
                for failTask in failTasks:
                    for subTask in subTasks:
                        self.oneMinimalLinks+=[(info["kind"], failTask, subTask)]

    def pairSameConfig(self):
        """sameConfigLinks : list of (conf, task, nextTask) between the run tasks of successive samples of a configuration.
        If a sample is executed several times, only its first execution is used"""
        runTasks={}
        for task in self.tasks:
            if task["kind"]=="run" and task["sample"]!=None:
                runTasks.setdefault(task["conf"],{}).setdefault(task["sample"], task)
        self.sameConfigLinks=[]
        for conf,tasksBySample in runTasks.items():
            samples=sorted(tasksBySample.keys())
            for sample,nextSample in zip(samples[:-1], samples[1:]):
                self.sameConfigLinks+=[(conf, tasksBySample[sample], tasksBySample[nextSample])]

    def pairSplit(self):
        """splitLinks : list of (conf, failTask, subTask) from the failing cmp task of a configuration split by
        splitDeltasAsync to the first task of each sub-configuration (event split)"""
        tasksByConf={}
        for task in self.tasks:
            tasksByConf.setdefault(task["conf"],[]).append(task)
        self.splitLinks=[]
        self.nbSplitWithoutTask=0
        for ev in self.events:
            if ev["ev"]!="event" or ev["name"]!="split":
                continue
            info=ev["info"]
            failTasks=[task for task in tasksByConf.get(info["conf"],[]) if task["kind"]=="cmp" and task["sample"]==info["sample"]
                       and task["status"] not in [0,None] and task["end"]<=ev["t"]]
            if len(failTasks)==0:
                self.nbSplitWithoutTask+=1 #FAIL from cache
                continue
            failTask=failTasks[-1]
            for subConf in info["subConfs"]:
                subTasks=[task for task in tasksByConf.get(subConf,[]) if task["begin"]>=ev["t"]]
                if len(subTasks)!=0: #else the status of the sub-configuration comes from the cache
                    self.splitLinks+=[(info["conf"], failTask, subTasks[0])]

    def links(self):
        """list of (name, info, startTask, endTask)"""
        return [("1-ddmin", kind, failTask, subTask) for kind,failTask,subTask in self.oneMinimalLinks]+\
               [("same_config", conf, task, nextTask) for conf,task,nextTask in self.sameConfigLinks]+\
               [("split", conf, failTask, subTask) for conf,failTask,subTask in self.splitLinks]

    def pairSections(self, category):
        """category in [phase, runtime] : list of dict (name, info, begin, end, depth, outermost)"""
        sections=[]
        stack=[]
        for ev in self.events:
            if ev["ev"]==category+"_begin":
                section={"name":ev["name"], "info":ev["info"], "begin":ev["t"], "end":None, "depth":len(stack),
                         "outermost": not (ev["name"] in [p["name"] for p in stack])}
                stack+=[section]
                sections+=[section]
            if ev["ev"]==category+"_end":
                while len(stack)!=0:
                    section=stack.pop()
                    section["end"]=ev["t"]
                    if section["name"]==ev["name"]:
                        break
        for section in stack:
            section["end"]=self.tEnd
        return sections

    def computeBusy(self):
        """Step function of the number of busy slots and its cumulative integral"""
        changes=[(task["begin"],1) for task in self.tasks]+[(task["end"],-1) for task in self.tasks]
        changes.sort()
        self.busyTime=[0.]
        self.busyValue=[0]
        self.busyIntegral=[0.]
        for t,delta in changes:
            if t==self.busyTime[-1]:
                self.busyValue[-1]+=delta
                continue
            self.busyIntegral+=[self.busyIntegral[-1]+ self.busyValue[-1]*(t-self.busyTime[-1])]
            self.busyTime+=[t]
            self.busyValue+=[self.busyValue[-1]+delta]

    def integralBusy(self, t):
        i=bisect.bisect_right(self.busyTime, t)-1
        if i<0:
            return 0.
        return self.busyIntegral[i]+self.busyValue[i]*(t-self.busyTime[i])

    def occupancy(self, begin, end):
        if end<=begin:
            return None
        return (self.integralBusy(end)-self.integralBusy(begin))/((end-begin)*self.nbSlot)

    def printSectionStats(self, title, sections, valueFunc, out):
        print("", file=out)
        print("%-45s %8s %12s %10s"%(title, "count", "time(s)", "occupancy"), file=out)
        names=[]
        for section in sections:
            if valueFunc(section) not in names:
                names+=[valueFunc(section)]
        for name in names:
            sectionTab=[p for p in sections if valueFunc(p)==name and p["outermost"]]
            duration=sum([p["end"]-p["begin"] for p in sectionTab])
            busySection=sum([self.integralBusy(p["end"])-self.integralBusy(p["begin"]) for p in sectionTab])
            occ="%.1f%%"%(100.*busySection/(duration*self.nbSlot)) if duration>0 else "-"
            count=len([p for p in sections if valueFunc(p)==name])
            print("%-45s %8i %12.3f %10s"%(name, count, duration, occ), file=out)

    def printStats(self, out=sys.stdout):
        nbRun=len([t for t in self.tasks if t["kind"]=="run"])
        nbCmp=len([t for t in self.tasks if t["kind"]=="cmp"])
        busy=sum([t["end"]-t["begin"] for t in self.tasks])
        evCount=lambda name : [ev for ev in self.events if ev["ev"]=="event" and ev["name"]==name]
        print("Wall time          : %.3fs"%(self.tEnd), file=out)
        print("Slots (nbProc)     : %i"%(self.nbSlot), file=out)
        print("Tasks              : %i run, %i cmp"%(nbRun, nbCmp), file=out)
        if nbRun!=0:
            print("Mean run duration  : %.3fs"%(sum([t["end"]-t["begin"] for t in self.tasks if t["kind"]=="run"])/nbRun), file=out)
        print("Busy time          : %.3fs"%(busy), file=out)
        if self.tEnd>0:
            print("Global occupancy   : %.1f%%"%(100.*busy/(self.tEnd*self.nbSlot)), file=out)
        print("Cache hits (conf)  : %i"%(len(evCount("cache"))), file=out)
        print("Early exits        : %i"%(len(evCount("earlyExit"))), file=out)
        print("Skipped sub-tasks  : %i"%(sum([ev["info"]["nbSkipped"] for ev in evCount("skip")])), file=out)
        print("1-ddmin links      : %i (%i ddmin, %i sub-configurations without traced cmp)"%(len(self.oneMinimalLinks),
              len(evCount("oneMinimal")), self.nbSubConfWithoutTask), file=out)
        print("same_config links  : %i"%(len(self.sameConfigLinks)), file=out)
        print("split links        : %i (%i split, %i split from cache)"%(len(self.splitLinks),
              len(evCount("split")), self.nbSplitWithoutTask), file=out)
        for slot in range(self.nbSlot):
            slotBusy=sum([t["end"]-t["begin"] for t in self.tasks if t["slot"]==slot])
            print("  slot %3i occupancy : %.1f%%"%(slot, 100.*slotBusy/self.tEnd if self.tEnd>0 else 0.), file=out)

        self.printSectionStats("phase", self.phases, lambda p: p["name"], out)
        self.printSectionStats("runtime", self.runtimes, runtimeValue, out)

    def records(self):
        """Generic timeline : list of (location, time, order, kind, data) sorted by (time, order).
        location in [algorithm, runtime, slot i] ; kind in [enter, leave, event, metric, linkStart, linkEnd].
        The links start and end at the middle of the tasks (cmp tasks for 1-ddmin, run tasks for same_config,
        failing cmp task to the first task of the sub-configuration for split).
        At the same date, leaves are before enters and the deepest sections leave first."""
        records=[]
        for location,sections,valueFunc in [("algorithm", self.phases, lambda p: p["name"]), ("runtime", self.runtimes, runtimeValue)]:
            for section in sections:
                records+=[(location, section["begin"], (1, section["depth"]), "enter",
                           {"value":valueFunc(section), "info":json.dumps(section["info"])})]
                records+=[(location, section["end"], (0, -section["depth"]), "leave", {"value":valueFunc(section)})]
        for task in self.tasks:
            location="slot %i"%(task["slot"])
            records+=[(location, task["begin"], (1, 0), "enter",
                       {"value":taskValue(task), "conf":task["conf"], "sample":task["sample"], "status":task["status"]})]
            records+=[(location, task["end"], (0, 0), "leave", {"value":taskValue(task)})]
        for ev in self.events:
            if ev["ev"]=="event" and ev["name"] in eventColors:
                records+=[("runtime", ev["t"], (2, 0), "event", {"value":ev["name"], "info":json.dumps(ev["info"])})]
        middle=lambda task: 0.5*(task["begin"]+task["end"])
        for i,(name,info,startTask,endTask) in enumerate(self.links()):
            data={"value":name, "key":"L%i"%(i), "info":info}
            records+=[("slot %i"%(startTask["slot"]), middle(startTask), (2, 1), "linkStart", data)]
            records+=[("slot %i"%(endTask["slot"]), middle(endTask), (2, 1), "linkEnd", data)]
        for t,value in zip(self.busyTime, self.busyValue):
            records+=[("runtime", t, (3, 0), "metric", {"value":value})]
        records.sort(key=lambda x: (x[1], x[2]))
        return records

    def locations(self):
        return ["algorithm", "runtime"]+["slot %i"%(slot) for slot in range(self.nbSlot)]

    def commandLine(self):
        return " ".join([Path(self.header["argv"][0]).name]+self.header["argv"][1:])


palette=["0.122 0.467 0.706", "1.0 0.498 0.055", "0.173 0.627 0.173", "0.839 0.153 0.157",
         "0.580 0.404 0.741", "0.549 0.337 0.294", "0.890 0.467 0.761", "0.498 0.498 0.498",
         "0.737 0.741 0.133", "0.090 0.745 0.812"]

taskColors={"run_PASS":"0.40 0.80 0.40", "run_FAIL":"0.90 0.30 0.30", "run_unknown":"0.70 0.70 0.70",
            "cmp_PASS":"0.20 0.50 0.20", "cmp_FAIL":"0.55 0.10 0.10", "cmp_unknown":"0.40 0.40 0.40",
            "ref_run":"0.30 0.50 0.90", "ref_cmp":"0.15 0.25 0.60"}

linkColors={"1-ddmin":"1.0 0.5 0.0", "same_config":"0.3 0.3 0.3", "split":"0.0 0.6 0.9"}

eventColors={"cache":"0.95 0.85 0.10", "earlyExit":"1.0 0.0 1.0", "skip":"0.0 0.0 0.0"}


def quote(value):
    if value==None:
        return '""'
    return '"'+str(value).replace('"',"'")+'"'


def taskValue(task):
    if task["conf"]=="ref":
        return "ref_"+task["kind"]
    return task["kind"]+"_"+task["sampleStatus"]


def writePaje(analysis, fileName):
    with open(fileName,"w") as out:
        w=lambda *args: out.write(" ".join([str(a) for a in args])+"\n")
        out.write("""%EventDef PajeDefineContainerType 0
% Alias string
% Type string
% Name string
%EndEventDef
%EventDef PajeDefineStateType 1
% Alias string
% Type string
% Name string
%EndEventDef
%EventDef PajeDefineEventType 2
% Alias string
% Type string
% Name string
%EndEventDef
%EventDef PajeDefineVariableType 3
% Alias string
% Type string
% Name string
% Color color
%EndEventDef
%EventDef PajeDefineEntityValue 4
% Alias string
% Type string
% Name string
% Color color
%EndEventDef
%EventDef PajeCreateContainer 5
% Time date
% Alias string
% Type string
% Container string
% Name string
%EndEventDef
%EventDef PajeDestroyContainer 6
% Time date
% Type string
% Name string
%EndEventDef
%EventDef PajePushState 7
% Time date
% Type string
% Container string
% Value string
% Conf string
% Sample string
% Status string
%EndEventDef
%EventDef PajePopState 8
% Time date
% Type string
% Container string
%EndEventDef
%EventDef PajeNewEvent 9
% Time date
% Type string
% Container string
% Value string
% Info string
%EndEventDef
%EventDef PajeSetVariable 10
% Time date
% Type string
% Container string
% Value double
%EndEventDef
%EventDef PajeDefineLinkType 11
% Alias string
% Type string
% StartContainerType string
% EndContainerType string
% Name string
%EndEventDef
%EventDef PajeStartLink 12
% Time date
% Type string
% Container string
% Value string
% StartContainer string
% Key string
% Info string
%EndEventDef
%EventDef PajeEndLink 13
% Time date
% Type string
% Container string
% Value string
% EndContainer string
% Key string
%EndEventDef
""")
        #types
        w(0, "CT_DD", 0, quote("DD"))
        w(0, "CT_Algo", "CT_DD", quote("Algorithm"))
        w(0, "CT_Runtime", "CT_DD", quote("Runtime"))
        w(0, "CT_Slot", "CT_DD", quote("Slot"))
        w(1, "ST_Phase", "CT_Algo", quote("Phase"))
        w(1, "ST_Runtime", "CT_Runtime", quote("Runtime"))
        w(1, "ST_Task", "CT_Slot", quote("Task"))
        w(2, "ET_Event", "CT_Runtime", quote("Event"))
        w(3, "VT_Busy", "CT_DD", quote("Busy slots"), quote("0.2 0.2 0.8"))
        for name in linkColors:
            w(11, "LT_"+name, "CT_DD", "CT_Slot", "CT_Slot", quote(name))

        #values
        stateTypes={"algorithm":"ST_Phase", "runtime":"ST_Runtime"}
        for location,sections,valueFunc,offset in [("algorithm", analysis.phases, lambda p: p["name"], 0),
                                                   ("runtime", analysis.runtimes, runtimeValue, 3)]:
            names=[]
            for section in sections:
                if valueFunc(section) not in names:
                    names+=[valueFunc(section)]
            for i,name in enumerate(names):
                w(4, "V_"+name, stateTypes[location], quote(name), quote(palette[(i+offset) % len(palette)]))
        for name,color in taskColors.items():
            w(4, "V_"+name, "ST_Task", quote(name), quote(color))
        for name,color in eventColors.items():
            w(4, "V_"+name, "ET_Event", quote(name), quote(color))
        for name,color in linkColors.items():
            w(4, "V_"+name, "LT_"+name, quote(name), quote(color))

        #containers
        containers={"algorithm":"C_Algo", "runtime":"C_Runtime"}
        w(5, 0., "C_DD", "CT_DD", 0, quote(analysis.commandLine()))
        w(5, 0., "C_Algo", "CT_Algo", "C_DD", quote("algorithm"))
        w(5, 0., "C_Runtime", "CT_Runtime", "C_DD", quote("runtime"))
        for slot in range(analysis.nbSlot):
            containers["slot %i"%(slot)]="C_Slot%i"%(slot)
            stateTypes["slot %i"%(slot)]="ST_Task"
            w(5, 0., "C_Slot%i"%(slot), "CT_Slot", "C_DD", quote("slot %i"%(slot)))

        #timeline
        for location,t,order,kind,data in analysis.records():
            date="%.6f"%(t)
            if kind=="enter":
                if location.startswith("slot"):
                    w(7, date, stateTypes[location], containers[location], "V_"+data["value"],
                      quote(data["conf"]), quote(data["sample"]), quote(data["status"]))
                else:
                    w(7, date, stateTypes[location], containers[location], "V_"+data["value"], quote(data["info"]), quote(""), quote(""))
            if kind=="leave":
                w(8, date, stateTypes[location], containers[location])
            if kind=="event":
                w(9, date, "ET_Event", containers[location], "V_"+data["value"], quote(data["info"]))
            if kind=="metric":
                w(10, date, "VT_Busy", "C_DD", data["value"])
            if kind=="linkStart":
                w(12, date, "LT_"+data["value"], "C_DD", "V_"+data["value"], containers[location], quote(data["key"]), quote(data["info"]))
            if kind=="linkEnd":
                w(13, date, "LT_"+data["value"], "C_DD", "V_"+data["value"], containers[location], quote(data["key"]))

        for slot in range(analysis.nbSlot):
            w(6, "%.6f"%(analysis.tEnd), "CT_Slot", "C_Slot%i"%(slot))
        w(6, "%.6f"%(analysis.tEnd), "CT_Runtime", "C_Runtime")
        w(6, "%.6f"%(analysis.tEnd), "CT_Algo", "C_Algo")
        w(6, "%.6f"%(analysis.tEnd), "CT_DD", "C_DD")
    return fileName


def importOtf2():
    try:
        import otf2
    except ImportError as e:
        print("Error: the OTF2 python binding (module otf2) is required by --format=otf2 (%s)"%(e), file=sys.stderr)
        sys.exit(1)
    return otf2


def writeOtf2(analysis, archivePath):
    """OTF2 archive : one location per container (algorithm, runtime, slots).
    The events (cache, earlyExit, skip) are written as zero-length regions with an info attribute."""
    otf2=importOtf2()
    from otf2.enums import Type
    timerResolution=1000000000 #ns
    date=lambda t: int(round(t*timerResolution))
    with otf2.writer.open(str(archivePath), timer_resolution=timerResolution) as trace:
        #a single location group : algorithm, runtime and slots are at the same level (as in the paje trace).
        #A location group with the same name as one of its locations is rejected by ViTE.
        rootNode=trace.definitions.system_tree_node("DD")
        group=trace.definitions.location_group(analysis.commandLine(), system_tree_parent=rootNode)
        writers={location: trace.event_writer(location, group=group)
                 for location in analysis.locations()}

        attributes={name: trace.definitions.attribute(name, name, Type.STRING) for name in ["info", "conf", "sample", "status"]}
        busy=trace.definitions.metric("Busy slots", unit="slots")
        regions={}
        def region(name):
            if name not in regions:
                regions[name]=trace.definitions.region(name)
            return regions[name]

        for location,t,order,kind,data in analysis.records():
            writer=writers[location]
            if kind=="enter":
                attrs={attributes[key]: str(data[key]) for key in ["info","conf","sample","status"] if key in data}
                writer.enter(date(t), region(data["value"]), attrs)
            if kind=="leave":
                writer.leave(date(t), region(data["value"]))
            if kind=="event":
                eventRegion=region("event_"+data["value"])
                writer.enter(date(t), eventRegion, {attributes["info"]: data["info"]})
                writer.leave(date(t), eventRegion)
            if kind=="metric":
                writer.metric(date(t), busy, float(data["value"]))
    return Path(archivePath) / "traces.otf2"


writers={"paje":(writePaje, ".paje.trace"), "otf2":(writeOtf2, ".otf2")}

class config_trace_convert(gen_config.gen_config):

    def __init__(self, argv, environ, config_keys=["DD_TRACE_CONVERT"]):
        if len(argv)<2:
            self.registryTab=[]
            self.registerOptions()
            self.usageCmd()
            self.failure()
        super().__init__(argv, environ, config_keys, None)
        self.normalize()

    def registerOptions(self):
        self.addRegistry("format",    "string", "FORMAT",     ["--format=","-f:"], "paje", list(writers.keys()),
                         docStr="output format in %s (default paje). otf2 requires the OTF2 python binding"%(list(writers.keys())))
        self.addRegistry("output",    "string", "OUTPUT",     ["--output=","-o:"], None,
                         docStr="output file for paje, archive directory for otf2 (default: TRACE_FILE with the .paje.trace or .otf2 suffix)")
        self.addRegistry("statsOnly", "bool",   "STATS_ONLY", ["--stats-only"],    False, docStr="only print the statistics")
        self.addRegistry("noStats",   "bool",   "NO_STATS",   ["--no-stats"],      False, docStr="do not print the statistics")

    def usageCmd(self):
        print("Usage: "+ Path(sys.argv[0]).name + " [options] TRACE_FILE")
        print("\t"+__doc__.replace("\n","\n\t"))
        print("\tTRACE_FILE : file generated by verrou_dd_* --trace-file=")
        print(self.get_EnvDoc())

    def normalize(self):
        if len(self.unknown_args)!=1:
            self.usageCmd()
            self.failure()
        self.traceFile=Path(self.unknown_args[0])
        if not self.traceFile.is_file():
            print("Error : %s should be a file"%(self.traceFile), file=sys.stderr)
            self.failure()
        if self.output==None:
            self.output=str(self.traceFile.with_suffix(writers[self.format][1]))


