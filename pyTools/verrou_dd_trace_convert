    conf=config_trace_convert(sys.argv, os.environ)

    if conf.format=="otf2" and not conf.statsOnly:
        importOtf2() #fail before the analysis

    header,events=loadTrace(conf.traceFile)
    analysis=traceAnalysis(header, events)
    if not conf.noStats:
        analysis.printStats()
    if not conf.statsOnly:
        writeFunc,suffix=writers[conf.format]
        print("%s trace written in %s"%(conf.format, writeFunc(analysis, conf.output)))
